<?xml version="1.0" encoding="utf-8"?>
<!--
  The artwork on a flat shade, with the launcher free to mask it into whatever
  shape the system is set to. The foreground keeps well inside the safe zone,
  so a circular mask does not clip the machine.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/gb_light" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
