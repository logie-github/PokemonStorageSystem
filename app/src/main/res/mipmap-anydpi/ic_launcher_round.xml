<?xml version="1.0" encoding="utf-8"?>
<!--
  The machine over its own halftone card rather than the launcher's bare
  container: the background layer is the pink/lavender/navy halftone art,
  full bleed, so every mask shape still finds colour at its very edge. The
  foreground keeps well inside the safe zone on top of it, so a circular mask
  does not clip the machine.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
