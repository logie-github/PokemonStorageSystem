<?xml version="1.0" encoding="utf-8"?>
<!--
  What goes into the account's backup when BACKUP TO GOOGLE is on, and what
  never does.

  The boxes go: they are the thing worth carrying to a new phone, and a
  restored Pokémon is checked against the cartridges before the app will treat
  it as its own (see AppSettings.restoredUids). Nothing else about the app is
  worth the space:

    * sprites, cries and follower sheets are downloaded art, hundreds of
      megabytes of it against the twenty-five the platform allows, and they
      come back with a tap
    * pc/backups holds the copy taken of a cartridge before each write, which
      is evidence about this device and belongs to it

  With the switch off, StorageBackupAgent writes nothing at all and none of
  this applies.
-->
<full-backup-content>
    <exclude domain="file" path="pc/backups/" />
    <exclude domain="file" path="sprites/" />
    <exclude domain="file" path="cries/" />
    <exclude domain="file" path="followers/" />
    <exclude domain="file" path="install.marker" />
    <exclude domain="file" path="last-crash.txt" />
</full-backup-content>
