<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: the boxes are never copied, in either direction. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pc/" />
        <exclude domain="file" path="sprites/" />
        <exclude domain="file" path="cries/" />
        <exclude domain="file" path="followers/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pc/" />
        <exclude domain="file" path="sprites/" />
        <exclude domain="file" path="cries/" />
        <exclude domain="file" path="followers/" />
    </device-transfer>
</data-extraction-rules>
